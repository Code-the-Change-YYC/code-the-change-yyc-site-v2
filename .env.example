# Copy to .env.local and fill in. Never commit .env.local.
#
# All Contentful values are SERVER-ONLY — do not add a NEXT_PUBLIC_ prefix to
# any of them. The old site shipped its delivery token to the browser as
# NEXT_PUBLIC_ACCESS_TOKEN; we are deliberately not repeating that.

# Contentful space. Settings → API keys.
CONTENTFUL_SPACE_ID=963e09izo0py
CONTENTFUL_ENVIRONMENT=master

# Content Delivery API token — published entries only.
CONTENTFUL_ACCESS_TOKEN=

# Content Preview API token — includes drafts. Used only in draft mode.
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Shared secret guarding /api/draft. Generate with: openssl rand -hex 32
CONTENTFUL_PREVIEW_SECRET=

# Shared secret guarding /api/revalidate. Must match the x-contentful-webhook-secret
# header configured on the Contentful webhook. Generate with: openssl rand -hex 32
CONTENTFUL_REVALIDATE_SECRET=

# Canonical origin, used for metadataBase / sitemap / robots.
# Optional locally; on Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
